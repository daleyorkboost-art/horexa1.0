generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  OPERATIONS
  CLIENT
}

enum RecordStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  INACTIVE
  ARCHIVED
  PENDING
  COMPLETED
  SCHEDULED
  CANCELLED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  CLOSED
}

enum TicketStatus {
  OPEN
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INQUIRY
  INSPECTION
  REPORT
  TICKET
  INVOICE
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  role          UserRole  @default(CLIENT)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  adminProfile  Admin?
  clientProfile Client?
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  title       String?
  department  String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id              String   @id @default(cuid())
  userId          String?  @unique
  companyName     String
  contactName     String?
  phone           String?
  email           String?
  city            String?
  address         String?
  amcPlanId       String?
  portalEnabled   Boolean  @default(false)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user              User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  amcPlan           AMCPlan? @relation(fields: [amcPlanId], references: [id], onDelete: SetNull)
  inquiries         Inquiry[]
  applications      Application[]
  inspectionReports InspectionReport[]
  complianceRecords ComplianceRecord[]
  documents         Document[]
  supportTickets    SupportTicket[]
}

model Service {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  summary     String
  description String       @db.Text
  category    String
  icon        String?
  imageUrl    String?
  sortOrder   Int          @default(0)
  status      RecordStatus @default(DRAFT)
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projects  Project[]
  inquiries Inquiry[]
}

model Project {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  location    String
  duration    String?
  kitchenType String?
  greaseLevel String?
  category    String
  serviceId   String?
  beforeImageUrl String?
  afterImageUrl  String?
  galleryUrls String[]     @default([])
  description String?      @db.Text
  status      RecordStatus @default(DRAFT)
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model AMCPlan {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  audience    String
  frequency   String
  description String       @db.Text
  features    String[]     @default([])
  priceLabel  String?
  recommended Boolean      @default(false)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  clients   Client[]
  inquiries Inquiry[]
}

model Inquiry {
  id          String        @id @default(cuid())
  fullName    String
  phone       String
  email       String
  businessName String?
  city        String?
  message     String?       @db.Text
  sourcePage  String?
  status      InquiryStatus @default(NEW)
  assignedTo  String?
  serviceId   String?
  amcPlanId   String?
  clientId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  amcPlan AMCPlan? @relation(fields: [amcPlanId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model BlogPost {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String
  content     String       @db.Text
  category    String
  tags        String[]     @default([])
  imageUrl    String?
  readTime    String?
  status      RecordStatus @default(DRAFT)
  featured    Boolean      @default(false)
  publishedAt DateTime?
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Career {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  location    String
  type        String
  experience  String
  description String       @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  applications Application[]
}

model Application {
  id          String       @id @default(cuid())
  careerId    String?
  clientId    String?
  fullName    String
  email       String
  phone       String?
  resumeUrl   String?
  message     String?      @db.Text
  status      RecordStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  career Career? @relation(fields: [careerId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Testimonial {
  id          String       @id @default(cuid())
  name        String
  business    String
  city        String
  quote       String       @db.Text
  rating      Int          @default(5)
  imageUrl    String?
  status      RecordStatus @default(DRAFT)
  featured    Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model InspectionReport {
  id              String       @id @default(cuid())
  clientId        String
  inspectionId    String       @unique
  type            String
  inspector       String
  score           Int
  reportUrl       String?
  beforeImageUrls String[]     @default([])
  afterImageUrls  String[]     @default([])
  recommendations String?      @db.Text
  status          RecordStatus @default(SCHEDULED)
  scheduledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  complianceRecords ComplianceRecord[]
}

model ComplianceRecord {
  id          String       @id @default(cuid())
  clientId    String
  reportId    String?
  category    String
  score       Int
  status      RecordStatus @default(ACTIVE)
  notes       String?      @db.Text
  checkedAt   DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  report InspectionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
}

model Document {
  id          String       @id @default(cuid())
  clientId    String?
  title       String
  category    String
  fileUrl     String
  fileType    String
  fileSize    Int?
  uploadedBy  String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String         @id @default(cuid())
  clientId    String?
  subject     String
  message     String         @db.Text
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  assignedTo  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  type      NotificationType
  title     String
  body      String           @db.Text
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
